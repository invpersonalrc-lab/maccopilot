# Copy this file to .env (same folder) and fill in the values after the = signs.
# .env is private: it is listed in .gitignore and is never uploaded to GitHub.
ANTHROPIC_API_KEY=
# Agent mode credentials. Claude only sees {{EMAIL}} / {{PASSWORD}}; Mac Copilot fills
# these in locally when typing, so they are never sent to Anthropic or written to logs.
MAC_COPILOT_EMAIL=
MAC_COPILOT_PASSWORD=
# Optional: choose a different model (default: claude-opus-5-5)
# MAC_COPILOT_MODEL=claude-sonnet-5-5
